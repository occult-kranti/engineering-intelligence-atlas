{
  "name": "research-director-mcp",
  "version": "0.1.0",
  "description": "Stdio MCP server bridging MCP clients (e.g. Claude Desktop) to the Research Director desktop companion over a loopback-only, token-authenticated HTTP bridge. Read-only by default.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "research-director-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
