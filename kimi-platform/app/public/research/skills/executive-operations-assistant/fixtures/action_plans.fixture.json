  "cacheInvalidation": {
    "namespaces": [
      "skill-excerpts",
      "blueprint",
      "snapshot",
      "repository-metadata"
    ],
    "description": "cache.invalidate receipt: counts only, never content. Namespace is explicit; scopeKey is an enterprise key (owner-scoped).",
    "cases": [
      {
        "name": "golden report from the shared fixture",
        "input": {
          "namespace": "snapshot",
          "scopeKey": "software",
          "removedKeys": 4,
          "invalidatedAt": 1732000001000
        },
        "expected": {
          "contractVersion": 1,
          "namespace": "snapshot",
          "scopeKey": "software",
          "removedKeys": 4,
          "invalidatedAt": 1732000001000
        }
      },
      {
        "name": "unknown namespace rejected",
        "input": {
          "namespace": "secrets",
          "scopeKey": "software",
          "removedKeys": 4,
          "invalidatedAt": 1732000001000
        },
        "expectError": "invalid-shape"
      }
    ]
  },
  "repositoryIntake": {
    "modes": [
      "public-anonymous",
      "credentialed-approved"
    ],
    "description": "Intake-mode credential rules enforced in code: public-anonymous forbids credentials; credentialed-approved requires a vault credential record and an approved repository.import proposal.",
    "cases": [
      {
        "name": "public anonymous intake",
        "request": {
          "contractVersion": 1,
          "url": "https://github.com/acme/ui-kit",
          "intakeMode": "public-anonymous",
          "credentialRecordId": null
        },
        "expect": {
          "ok": true
        }
      },
      {
        "name": "credentialed intake with vault record",
        "request": {
          "contractVersion": 1,
          "url": "https://github.com/acme/private-kit",
          "intakeMode": "credentialed-approved",
          "credentialRecordId": 42
        },
        "expect": {
          "ok": true
        }
      },
      {
        "name": "credentialed intake without vault record",
        "request": {
          "contractVersion": 1,
          "url": "https://github.com/acme/private-kit",
          "intakeMode": "credentialed-approved",
          "credentialRecordId": null
        },
        "expect": {
          "ok": false,
          "code": "credentials-required"
        }
      },
      {
        "name": "public intake must not use credentials",
        "request": {
          "contractVersion": 1,
          "url": "https://github.com/acme/ui-kit",
          "intakeMode": "public-anonymous",
          "credentialRecordId": 7
        },
        "expect": {
          "ok": false,
          "code": "credential-not-permitted"
        }
      }
    ]
  },
