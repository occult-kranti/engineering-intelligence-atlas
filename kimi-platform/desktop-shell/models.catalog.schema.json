{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-director.local/models.catalog.schema.json",
  "title": "Research Director Desktop model catalog",
  "type": "object",
  "required": ["version", "models"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sizeBytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\\\][^\\x00]*$",
          "description": "Repo-relative POSIX path. Validated against traversal/absolute paths at load time."
        },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "description": "HF-published LFS SHA-256; null when HF masks it (e.g. gated repos)."
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "task",
        "repoId",
        "revision",
        "format",
        "quantization",
        "sizeBytes",
        "files",
        "minRamBytes",
        "minVramBytes",
        "license",
        "sourceUrl",
        "runtime",
        "remoteCodeRequired",
        "availability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "description": "Stable unique catalog id."
        },
        "family": { "type": "string", "minLength": 1, "description": "Model family, e.g. 'qwen3'." },
        "task": { "type": "string", "minLength": 1, "description": "Primary task, e.g. 'text-generation'." },
        "name": { "type": "string", "description": "Human-readable display name." },
        "repoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "description": "Hugging Face repo id 'owner/name'."
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Pinned full git commit SHA. Moving refs (main, tags) are not allowed."
        },
        "format": { "type": "string", "minLength": 1, "description": "e.g. 'GGUF', 'safetensors (bf16)'." },
        "quantization": { "type": ["string", "null"], "description": "e.g. 'Q4_K_M', or null." },
        "sizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Must equal the sum of files[].sizeBytes for 'available' models."
        },
        "sizeScope": { "type": "string", "description": "Whether sizeBytes is a single file or a required set." },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" },
          "description": "Exact reviewed file set. Required non-empty for 'available' models; downloads use this set, never a live tree listing."
        },
        "minRamBytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Hard memory floor. Null means 'not declared/derivable' — reported as unknown, NOT zero."
        },
        "minVramBytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Null means 'not declared/derivable' — reported as unknown, NOT zero."
        },
        "license": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "pattern": "^https://" },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "description": "Intended runtime, e.g. 'llama.cpp', 'transformers'."
        },
        "remoteCodeRequired": {
          "type": "boolean",
          "description": "If true the entry MUST be availability 'quarantined'; this shell never executes remote code."
        },
        "availability": {
          "type": "string",
          "enum": ["available", "unavailable", "quarantined"],
          "description": "available = downloadable with confirmation; unavailable = verified but gated/not anonymously downloadable; quarantined = research-only, requires remote code, download/run disabled."
        },
        "availabilityNote": {
          "type": "string",
          "description": "Required whenever availability is not 'available'."
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "remoteCodeRequired": { "const": true } } },
          "then": { "properties": { "availability": { "const": "quarantined" } } }
        },
        {
          "if": { "properties": { "availability": { "enum": ["unavailable", "quarantined"] } } },
          "then": { "required": ["availabilityNote"] }
        }
      ]
    }
  }
}
