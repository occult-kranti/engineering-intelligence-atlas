# Static atlas builds do not need this file or any credentials.
# For the dynamic runtime, provision the services below and keep values private.
APP_ID=
APP_SECRET=
DATABASE_URL=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=
PORT=3000

# Optional platform gateway and object storage. Never prefix secrets with VITE_.
KIMI_AGENTGW_BASE_URL=
KIMI_AGENTGW_API_KEY=
KIMI_STORAGE_RESOURCE_ID=

# Optional server-only direct provider configuration.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Actual rates for the configured model, in USD per million tokens. Blank means unknown.
# Cache hints are enabled only when both cache rates are configured; no prices are guessed.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_CACHE_READ_USD_PER_MILLION=
OPENAI_CACHE_WRITE_USD_PER_MILLION=
ANTHROPIC_INPUT_USD_PER_MILLION=
ANTHROPIC_OUTPUT_USD_PER_MILLION=
ANTHROPIC_CACHE_READ_USD_PER_MILLION=
ANTHROPIC_CACHE_WRITE_USD_PER_MILLION=
GATEWAY_INPUT_USD_PER_MILLION=
GATEWAY_OUTPUT_USD_PER_MILLION=
# Exact comma-separated model IDs verified by the operator to support OpenAI explicit caching.
# No wildcard matching, automatic model upgrades, extended TTL, or paid prewarm calls.
OPENAI_EXPLICIT_CACHE_MODELS=

# Required to store user-supplied integration keys: 32 random bytes as 64 hex chars.
INTEGRATION_ENCRYPTION_KEY=

# Integration tests are explicit opt-ins. Use an isolated test database/account.
RUN_DATABASE_TESTS=0
RUN_STORAGE_TESTS=0
RUN_LIVE_AI_TESTS=0
