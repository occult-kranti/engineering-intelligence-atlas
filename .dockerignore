# Allow only the inputs used by deploy/Dockerfile into the build context.
**
!deploy/
!deploy/Dockerfile
!deploy/ollama.Dockerfile
!deploy/healthcheck.mjs
!deploy/runtime-request.mjs
!headless-runtime/
!headless-runtime/*.mjs
!headless-runtime/tsconfig.json
!desktop-shell/
!desktop-shell/package.json
!desktop-shell/package-lock.json
!desktop-shell/tsconfig.json
!desktop-shell/src/
!desktop-shell/src/**
!native-core/
!native-core/Cargo.toml
!native-core/Cargo.lock
!native-core/src/
!native-core/src/**
!company/
!company/**
!tools/
!tools/atlas-mcp.mjs
!tools/daftar-runtime-mcp.mjs

# These exclusions apply even if an allowed directory later contains a secret.
**/.env
**/.env.*
**/*.key
**/*.pem
**/secrets
**/secrets/**
**/node_modules
**/target
**/dist
