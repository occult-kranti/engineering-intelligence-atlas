# Nonsecret configuration. Values are file paths, never provider keys.
DAFTAR_CONCURRENCY=2
# Bootstrap interpreter for managed Python; must have venv and ensurepip.
# DAFTAR_PYTHON_PATH=/usr/bin/python3
DAFTAR_ALLOWED_HOSTS=127.0.0.1:8788,localhost:8788,[::1]:8788
# OPENAI_API_KEY_FILE=/etc/daftar/secrets/openai-api-key
# ANTHROPIC_API_KEY_FILE=/etc/daftar/secrets/anthropic-api-key
# GITHUB_TOKEN_FILE=/etc/daftar/secrets/github-token
# Enable only after verifying OLLAMA_NO_CLOUD=1 on the managed local daemon.
# DAFTAR_OLLAMA_LOCAL_ONLY=1
# DAFTAR_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Existing website writer pairing; prepare migration before enabling.
# DAFTAR_CLOUD_SYNC=1
# DAFTAR_CLOUD_URL=https://your-workspace.example
# DAFTAR_CLOUD_PAIRING_FILE=/etc/daftar/secrets/cloud-pairing
# DAFTAR_CLOUD_ENCRYPTION_KEY_FILE=/etc/daftar/secrets/cloud-encryption-key
# DAFTAR_CLOUD_SYNC_INTERVAL_SECONDS=60
# DAFTAR_CLOUD_ALLOW_KNOWN_SCHEMA_DEFAULTS=0
