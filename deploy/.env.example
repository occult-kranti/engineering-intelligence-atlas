# Used with: docker compose --env-file deploy/.env -f deploy/compose.yaml ...
# Paths below are container paths. Secret values never belong in this file.
DAFTAR_NODE_IMAGE=node:24-bookworm-slim
DAFTAR_RUST_IMAGE=rust:1.100.0-bookworm
DAFTAR_CONCURRENCY=2
DAFTAR_VOLUME_NAME=daftar_runtime_data

# Set only after creating the matching file with manage-secrets.py.
OPENAI_API_KEY_FILE=
ANTHROPIC_API_KEY_FILE=
GITHUB_TOKEN_FILE=

# Optional compose.ollama.yaml. Pin a reviewed image digest in production.
DAFTAR_OLLAMA_IMAGE=ollama/ollama:latest
DAFTAR_OLLAMA_MEMORY=6g
DAFTAR_OLLAMA_CPUS=4
DAFTAR_OLLAMA_VOLUME_NAME=daftar_ollama_models

# Optional existing website device pairing. Off by default; no automatic migration.
DAFTAR_CLOUD_SYNC=0
DAFTAR_CLOUD_URL=
DAFTAR_CLOUD_PAIRING_FILE=
DAFTAR_CLOUD_ENCRYPTION_KEY_FILE=
DAFTAR_CLOUD_SYNC_INTERVAL_SECONDS=60
# Only for a reviewed, released-writer migration with an empty command queue.
DAFTAR_CLOUD_ALLOW_KNOWN_SCHEMA_DEFAULTS=0
