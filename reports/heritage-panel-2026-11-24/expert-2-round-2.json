  "outcome": "pass-for-reviewed-preservation-and-documented-engine-scope; final publication requires the moderator's separate integration and release gates",
  "summary": "All seven current web models match their catalog hashes, acquired-source hashes and decoded preservation receipts when accessor metadata is compared by semantic binding. Fifty targeted tests pass. The Godot documentation now distinguishes the three previously executed engine audits, eligible but unexecuted Giza plateau, and three quantized pyramid derivatives rejected by the current preflight. No geometry, engine results, field accuracy or completed later review round was invented.",
  "findings": [
    {
      "id": "E2-R2-01",
      "severity": "medium",
      "status": "fixed-locally",
      "finding": "A generic instruction to decode a web GLB before the Godot audit omitted the non-normalized Float32 POSITION restriction.",
      "relatedFinding": "E3-R2-02",
      "change": "Documented component type 5126, the retained normalized signed 16-bit positions in Khufu/Khafre/Menkaure, the three actual engine-audited models and the absence of a Giza-plateau engine receipt.",
      "evidence": [
        "integrations/godot-heritage-review/glb.mjs",
        "integrations/godot-heritage-review/README.md",
        "projects/architecture-library/site-models/README.md"
      ],
      "acceptance": "Actual decoded-GLB preflight accepts the four Float32 inputs and rejects the three quantized pyramid inputs; the documentation retains that distinction from Godot engine compatibility."
    },
    {
      "id": "E2-R2-02",
      "severity": "info",
      "status": "disclosed-limitation",
      "finding": "Fine feature fidelity, physical scale, full coverage and field accuracy remain unverified for the supplied collection.",
      "evidence": [
        "projects/architecture-library/site-models/ACCURACY.md",
        "projects/architecture-library/site-models/catalog.json"
      ],
      "acceptance": "All seven catalog entries keep measurement disabled and metric verification false; context sources are not relabeled complete surveys."
    }
  ],
