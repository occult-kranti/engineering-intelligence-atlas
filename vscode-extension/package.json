{
  "name": "atlas-office",
  "displayName": "Daftar — Donna and One Office",
  "description": "The Daftar infinite office canvas, Donna, models and owned cloud compute inside VS Code.",
  "version": "0.9.1",
  "publisher": "occult-kranti",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "daftar",
    "atlas",
    "agents",
    "donna",
    "roadmap",
    "office"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/occult-kranti/engineering-intelligence-atlas.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/occult-kranti/engineering-intelligence-atlas/tree/main/vscode-extension",
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Daftar can enqueue agent work and control the connected workspace. Trust the VS Code folder before connecting."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onView:atlas.office"
  ],
  "contributes": {
    "commands": [
      {
        "command": "atlas.openOffice",
        "title": "Daftar: Open Office"
      },
      {
        "command": "atlas.connectDesktop",
        "title": "Daftar: Connect to Desktop"
      },
      {
        "command": "atlas.connectCloud",
        "title": "Daftar: Connect to Signed-in Website"
      },
      {
        "command": "atlas.disconnect",
        "title": "Daftar: Disconnect This Editor"
      },
      {
        "command": "atlas.refresh",
        "title": "Daftar: Refresh Workspace"
      },
      {
        "command": "atlas.openWebsite",
        "title": "Daftar: Open Connected Website"
      },
      {
        "command": "atlas.openMcpGuide",
        "title": "Daftar: Open MCP Setup Guide"
      },
      {
        "command": "atlas.startLocalRuntime",
        "title": "Daftar: Start Workspace on This Host"
      },
      {
        "command": "atlas.connectRuntime",
        "title": "Daftar: Connect Private Runtime"
      },
      {
        "command": "atlas.connectCompute",
        "title": "Daftar: Connect Vast.ai / SSH Compute"
      },
      {
        "command": "atlas.openComputeCenter",
        "title": "Daftar: Donna Compute and Ownership"
      },
      {
        "command": "atlas.hireCloudOperator",
        "title": "Daftar: Hire Cloud Compute Operator"
      },
      {
        "command": "atlas.copyMcpConfig",
        "title": "Daftar: Copy Runtime MCP Configuration"
      },
      {
        "command": "atlas.startPersistentRuntime",
        "title": "Daftar: Start Persistent Workspace in tmux"
      },
      {
        "command": "atlas.manageTeam",
        "title": "Daftar: Manage Team and Departments"
      },
      {
        "command": "atlas.reviewOwnership",
        "title": "Daftar: Review Donna Ownership"
      },
      {
        "command": "atlas.creativeTools",
        "title": "Daftar: Creative Tools"
      },
      {
        "command": "atlas.creativeDevelopment",
        "title": "Daftar: Creative Development"
      },
      {
        "command": "atlas.yugaWorkbench",
        "title": "Daftar: Plan Yuga GPU Workbench"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atlas",
          "title": "Daftar",
          "icon": "media/atlas.svg"
        }
      ]
    },
    "views": {
      "atlas": [
        {
          "id": "atlas.office",
          "name": "Companies and work",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Daftar Office",
      "properties": {
        "atlas.websiteUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "HTTPS origin of your private Daftar website. Device secrets are stored separately in VS Code SecretStorage."
        },
        "atlas.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to Node.js 22+ on the extension host. Empty uses VS Code bundled Node mode."
        },
        "atlas.hostControlEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "On Linux, expose host-control capabilities when starting the owned runtime. Policy remains off until configured by the owner."
        }
      }
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "test:installed": "node scripts/smoke-installed.mjs",
    "vscode:prepublish": "npm run check && npm test",
    "package": "node scripts/package-extension.mjs",
    "build": "node scripts/build-studio-assets.mjs && node scripts/build-runtime.mjs",
    "package:build": "npm run build && npm run package"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.27.2"
  }
}
