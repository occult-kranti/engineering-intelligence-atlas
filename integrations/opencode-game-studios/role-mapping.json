      "resources/modules/programming/agents/gameplay-programmer.md",
      "resources/modules/programming/agents/tools-programmer.md",
      "resources/modules/architecture/agents/lead-programmer.md",
      "resources/modules/engine-godot/agents/godot-specialist.md"
    ],
    "design-and-graphics": [
      "resources/modules/design/agents/game-designer.md",
